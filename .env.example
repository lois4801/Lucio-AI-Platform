# Lucio AI Platform — local secrets (gitignored, never commit real values)
# Copy this file to .env and fill in your own keys.

# LIVE market scan provider (owner directive: scan with real Google data).
# Get a key: https://console.cloud.google.com/apis/credentials — enable
# "Places API (New)". While unset, scans use the labeled fixture directory.
GOOGLE_PLACES_API_KEY=

# Street-view embeds in the discovery map popups ("drive mode").
# Restrict the key to the Maps Embed API. While unset, street view is hidden.
GOOGLE_MAPS_EMBED_KEY=

# Card billing for client deals (optional). While unset, deals run in manual
# invoice mode — you bill the client yourself and keep 100% (no platform cut).
STRIPE_SECRET_KEY=

# Public address clients use to reach this app (your hosted domain or tunnel,
# e.g. https://lucio.yourdomain.com). All copied share links (live sites,
# owner portals, review pages, template previews) use this base so they work
# on the client's device. While unset, links fall back to localhost.
PUBLIC_BASE_URL=

# Supabase cloud backup / sync target (optional). The `lucio` schema lives in
# your Supabase project; run `node scripts/export-to-supabase.mjs` to push the
# local SQLite database into it. Use the SERVICE ROLE key (server-side only —
# never expose it in the browser or commit it).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
